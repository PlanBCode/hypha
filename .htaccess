RewriteEngine On

# Basic security headers, also for the pages and files that index.php serves.
# Skipped when mod_headers is not loaded. Setting them in the virtual host
# instead is fine; "set" replaces rather than duplicates.
<IfModule mod_headers.c>
	Header always set X-Content-Type-Options "nosniff"
	Header always set Referrer-Policy "strict-origin-when-cross-origin"
	Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Pass system and data urls through index.php, so it can do access control
RewriteRule ^(system/.*)$ index.php [L]
RewriteRule ^(data/.*)$ index.php [L]

# Let index.php handle that do not point to a valid file or directory
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php [L]
